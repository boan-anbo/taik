{
  "name": "@taik/capabilities",
  "version": "0.1.0",
  "private": true,
  "description": "Platform capability interface contracts for Taik",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./storage": {
      "import": "./dist/storage/index.mjs",
      "require": "./dist/storage/index.js",
      "types": "./dist/storage/index.d.ts"
    },
    "./system": {
      "import": "./dist/system/index.mjs",
      "require": "./dist/system/index.js",
      "types": "./dist/system/index.d.ts"
    },
    "./audio": {
      "import": "./dist/audio/index.mjs",
      "require": "./dist/audio/index.js",
      "types": "./dist/audio/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/storage/index.ts src/system/index.ts src/audio/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/storage/index.ts src/system/index.ts src/audio/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "src"
  ]
}
